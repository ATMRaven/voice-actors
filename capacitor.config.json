{
  "appId": "com.atmr.voiceactors",
  "appName": "Voice Actors",
  "webDir": "static",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "url": "https://voxflow-809.pages.dev",
    "errorPath": "offline.html",
    "allowNavigation": [
      "voxflow-809.pages.dev"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": false,
      "backgroundColor": "#F3F1EC",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F3F1EC"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
